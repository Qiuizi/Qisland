#!/usr/bin/env bash
# 从标准输入读 JSON，推到 Windows 上的 Qisland。
# 镜像网络：127.0.0.1 即可。
# NAT：再试 resolv.conf 的 nameserver；仍失败就把文件写到 Windows 收件箱。
# 只投一个入口；消息带上 $type，由 Qisland 按类别解析，脚本不再自己挑接口。
set -u
PORT="${QISLAND_PORT:-9840}"
TOKEN="${QISLAND_TOKEN:-}"
TYPE="${QISLAND_TYPE:-push}"
while [ $# -gt 0 ]; do
  case "$1" in
    --type=*) TYPE="${1#*=}"; shift ;;
    --type) TYPE="${2:-}"; shift 2 ;;
    *) shift ;;
  esac
done
case "$TYPE" in
  push|ingest|hook) ;;
  *) TYPE="push" ;;
esac
BODY="$(cat)"
if [ -z "$BODY" ]; then
  exit 0
fi
BODY="$(printf '%s' "$BODY" | sed -e 's/^[[:space:]]*//')"
if [ "$BODY" = "{}" ]; then
  BODY="{\"\$type\":\"${TYPE}\"}"
elif [ "${BODY#\{}" != "$BODY" ] && ! printf '%s' "$BODY" | grep -q '"\$type"[[:space:]]*:'; then
  BODY="{\"\$type\":\"${TYPE}\",${BODY:1}"
fi

win_user() {
  if [ -z "${WIN_USER:-}" ] && command -v cmd.exe >/dev/null 2>&1; then
    WIN_USER="$(cmd.exe /c "echo %USERNAME%" 2>/dev/null | tr -d '\r')"
  fi
  printf '%s' "${WIN_USER:-}"
}

# Token：环境变量 QISLAND_TOKEN 优先，其次是 Windows 上 Qisland 的 api-token.txt（没有就不带）
if [ -z "$TOKEN" ]; then
  TOKEN_FILE="${QISLAND_API_TOKEN_FILE:-}"
  if [ -z "$TOKEN_FILE" ]; then
    U="$(win_user)"
    [ -n "$U" ] && TOKEN_FILE="/mnt/c/Users/${U}/AppData/Roaming/Qisland/api-token.txt"
  fi
  if [ -n "$TOKEN_FILE" ] && [ -r "$TOKEN_FILE" ]; then
    TOKEN="$(tr -d '\r\n' < "$TOKEN_FILE")"
  fi
fi

post() {
  if [ -n "$TOKEN" ]; then
    curl -fsS -m 2 -X POST "$1" \
      -H "Content-Type: application/json" \
      -H "X-Qisland-Token: $TOKEN" \
      -H "X-WinIslands-Token: $TOKEN" \
      --data-binary "$BODY"
  else
    curl -fsS -m 2 -X POST "$1" \
      -H "Content-Type: application/json" \
      --data-binary "$BODY"
  fi
}

PATH_SUFFIX="/v1/qisland/ingest"

if post "http://127.0.0.1:${PORT}${PATH_SUFFIX}" >/dev/null; then
  exit 0
fi

HOST=""
if [ -r /etc/resolv.conf ]; then
  HOST="$(awk '/^nameserver / { print $2; exit }' /etc/resolv.conf)"
fi
if [ -z "$HOST" ]; then
  HOST="$(ip route show default 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "via") { print $(i + 1); exit } }')"
fi
if [ -n "$HOST" ] && [ "$HOST" != "127.0.0.1" ]; then
  if post "http://${HOST}:${PORT}${PATH_SUFFIX}" >/dev/null; then
    exit 0
  fi
fi

WIN_USER="$(win_user)"
if [ -z "$WIN_USER" ]; then
  echo "qisland-push: 设好 WIN_USER 后再写收件箱" >&2
  exit 1
fi
INBOX="/mnt/c/Users/${WIN_USER}/AppData/Roaming/Qisland/inbox"
mkdir -p "$INBOX" 2>/dev/null || true
STAMP="$(date +%s%N 2>/dev/null || date +%s)"
printf '%s\n' "$BODY" > "${INBOX}/${STAMP}.json"
exit 0
